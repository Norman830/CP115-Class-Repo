    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="distancekm" type="Integer" array="False" size=""/>
            <input variable="distancekm"/>
            <declare name="literused" type="Integer" array="False" size=""/>
            <assign variable="literused" expression="distancekm /100"/>
            <declare name="totalprice" type="Integer" array="False" size=""/>
            <assign variable="totalprice" expression="literused * 2.05"/>
            <output expression="totalprice" newline="True"/>
        </body>
    </function>
</flowgorithm>
