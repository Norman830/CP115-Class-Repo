    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="numNight" type="Integer" array="False" size=""/>
            <input variable="numNight"/>
            <declare name="totalPayment" type="Integer" array="False" size=""/>
            <assign variable="totalPayment" expression="numNight * 250 + (250 * 15 / 100)"/>
            <output expression="totalPayment" newline="True"/>
        </body>
