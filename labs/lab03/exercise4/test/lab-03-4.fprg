    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="pages" type="Integer" array="False" size=""/>
            <input variable="pages"/>
            <declare name="totalCost" type="Integer" array="False" size=""/>
            <assign variable="totalCost" expression="pages + 3 + (pages * 0.20)"/>
            <output expression="totalCost" newline="True"/>
        </body>
